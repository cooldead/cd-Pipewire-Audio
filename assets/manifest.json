{
	"Name": "CooldeadPipeWire",
	"Description": "Native (Rust) PipeWire/WirePlumber audio control for OpenDeck. No Node.js.",
	"Author": "Stephane Jourdois",
	"Version": "0.5.0",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/cooldeadpipewire",
		"aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/cooldeadpipewire"
	},
	"CodePathLin": "x86_64-unknown-linux-gnu/bin/cooldeadpipewire",
	"Icon": "icons/plugin",
	"Category": "CooldeadPipeWire",
	"OS": [
		{
			"Platform": "linux"
		}
	],
	"Actions": [
		{
			"Icon": "icons/volume",
			"Name": "Output Volume",
			"States": [
				{
					"Image": "icons/volume"
				}
			],
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"Tooltip": "Adjust the default output volume",
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust volume",
					"Push": "Toggle mute",
					"Touch": "Toggle mute"
				}
			},
			"UUID": "com.cooldeadpipewire.pipewire.volume",
			"PropertyInspectorPath": "propertyInspector/volume.html"
		},
		{
			"Icon": "icons/volume",
			"Name": "Output Device Volume",
			"States": [
				{
					"Image": "icons/volume"
				}
			],
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"Tooltip": "Adjust a specific output device's volume",
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust volume",
					"Push": "Toggle mute",
					"Touch": "Toggle mute"
				}
			},
			"UUID": "com.cooldeadpipewire.pipewire.devicevolume",
			"PropertyInspectorPath": "propertyInspector/deviceVolume.html"
		},
		{
