{
    "Name": "CooldeadPipeWire",
    "Description": "Native (Rust) PipeWire/WirePlumber audio control for OpenDeck. No Node.js.",
    "Author": "Stephane Jourdois",
    "Version": "0.5.0",
    "CodePaths": {
        "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/cooldeadpipewire",
        "aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/cooldeadpipewire"
    },
    "CodePathLin": "x86_64-unknown-linux-gnu/bin/cooldeadpipewire",
    "Icon": "icons/plugin",
    "Category": "CooldeadPipeWire",
    "OS": [
        {
            "Platform": "linux"
        }
    ],
    "Actions": [
        {
            "Icon": "icons/appVolume",
            "Name": "Active Application Volume",
            "States": [
                {
                    "Image": "icons/appVolume"
                }
            ],
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "SupportedInMultiActions": true,
            "Tooltip": "Adjust the audio volume of the currently focused application",
            "Encoder": {
                "layout": "$B1",
                "TriggerDescription": {
                    "Rotate": "Adjust active application volume",
                    "Push": "Toggle mute",
                    "Touch": "Toggle mute"
                }
            },
            "UUID": "com.cooldeadpipewire.pipewire.activeappvolume",
            "PropertyInspectorPath": "propertyInspector/activeAppVolume.html"
        }
    ]
}
