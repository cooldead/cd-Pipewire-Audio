{
    "Name": "CD-Active App Volume for KDE",
    "Description": "Native (Rust) PipeWire/WirePlumber audio control for OpenDeck. No Node.js.",
    "Author": "Stephane Jourdois",
    "Version": "0.5.0",
    "CodePaths": {
        "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/cd-active-app-volume",
        "aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/cd-active-app-volume"
    },
    "CodePathLin": "x86_64-unknown-linux-gnu/bin/cd-active-app-volume",
    "Icon": "icons/plugin",
    "Category": "CD-Active App Volume for KDE",
    "OS": [
        {
            "Platform": "linux"
        }
    ],
    "Actions": [
        {
            "Icon": "icons/appVolume",
            "Name": "CD-Active App Volume",
            "States": [
                {
                    "Image": "icons/appVolume"
                }
            ],
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "SupportedInMultiActions": true,
            "Tooltip": "Adjust the audio volume of the currently focused application",
            "Encoder": {
                "layout": "layouts/active-app-volume.json",
                "TriggerDescription": {
                    "Rotate": "Adjust active application volume",
                    "Push": "Toggle mute",
                    "Touch": "Toggle mute"
                }
            },
            "UUID": "com.cooldeadpipewire.pipewire.activeappvolume",
            "PropertyInspectorPath": "propertyInspector/activeAppVolume.html"
        }
    ]
}
